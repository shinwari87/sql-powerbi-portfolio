                "    {\"S026\", \"Billing and payments\", \"The air purifier I bought 6 days ago just went on sale. Can I get the lower price?\", \"We offer one price adjustment per order within 14 days of purchase. At 6 days your order qualifies, so I have refunded the difference to your original payment method. Price adjustments apply to the same item and color and exclude clearance pricing.\", \"Thanks for reaching out. We offer one price adjustment per order within 14 days of purchase. At 6 days your order qualifies, so I have refunded the difference to your original payment method. Price adjustments apply to the same item and color and exclude clearance pricing.\", \"Happy to help with that. We offer one price adjustment per order within 14 days of purchase. At 6 days your order qualifies, so I have refunded the difference to your original payment method. Price adjustments apply to the same item and color and exclude clearance pricing.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S027\", \"Billing and payments\", \"The office chair I bought 13 days ago just went on sale. Can I get the lower price?\", \"We offer one price adjustment per order within 14 days of purchase. At 13 days your order qualifies, so I have refunded the difference to your original payment method. Price adjustments apply to the same item and color and exclude clearance pricing.\", \"Thanks for reaching out. We offer one price adjustment per order within 14 days of purchase. At 13 days your order qualifies, so I have refunded the difference to your original payment method. Price adjustments apply to the same item and color and exclude clearance pricing.\", \"Happy to help with that. We offer one price adjustment per order within 14 days of purchase. At 13 days your order qualifies, so I have refunded the difference to your original payment method. Price adjustments apply to the same item and color and exclude clearance pricing.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S028\", \"Billing and payments\", \"The monitor I bought 20 days ago just went on sale. Can I get the lower price?\", \"We offer one price adjustment per order within 14 days of purchase. At 20 days your order is past the window, so we are not able to refund the difference. Price adjustments apply to the same item and color and exclude clearance pricing.\", \"Thanks for reaching out. We offer one price adjustment per order within 14 days of purchase. Price adjustments apply to the same item and color and exclude clearance pricing.\", \"Happy to help with that. We offer one price adjustment per order within 14 days of purchase. At 20 days your order is past the window, so we are not able to refund the difference. Price adjustments apply to the same item and color and exclude clearance pricing.\", \"Fail\", \"Pass\", \"Incomplete answer\", \"\", \"Missing required element: \"\"past the window\"\".\", \"\", \"Improved\"},",
                "    {\"S029\", \"Billing and payments\", \"I forgot to enter the promo code WELCOME10 on my order from this morning. Can you add it?\", \"Promo codes have to be entered at checkout; they cannot be applied to an order after it is placed. The code stays valid for 30 days, so you can use it on your next order. If the order is still in Processing you may cancel it and reorder with the code.\", \"Thanks for reaching out. Sure, I've applied WELCOME10 and refunded the 10% difference. The code stays valid for 30 days, so you can use it on your next order. If the order is still in Processing you may cancel it and reorder with the code.\", \"Happy to help with that. Promo codes have to be entered at checkout; they cannot be applied to an order after it is placed. The code stays valid for 30 days, so you can use it on your next order. If the order is still in Processing you may cancel it and reorder with the code.\", \"Fail\", \"Pass\", \"Unsupported promise\", \"\", \"Contains prohibited claim: \"\"I've applied WELCOME10\"\".\", \"\", \"Improved\"},",
                "    {\"S030\", \"Billing and payments\", \"I need an invoice with my company name for order LG-48230 for an expense claim.\", \"Open Orders in your account, select LG-48230, and choose Download invoice. To show a company name, add it to your billing address under Account settings before downloading; the invoice updates immediately. The invoice includes the sales tax charged for your shipping address.\", \"Thanks for reaching out. Open Orders in your account, select LG-48230, and choose Download invoice. The invoice includes the sales tax charged for your shipping address.\", \"Happy to help with that. Open Orders in your account, select LG-48230, and choose Download invoice. The invoice includes the sales tax charged for your shipping address.\", \"Fail\", \"Fail\", \"Missing required step\", \"Missing required step\", \"Missing required element: \"\"billing address\"\".\", \"Missing required element: \"\"billing address\"\".\", \"Both fail\"},",
                "    {\"S031\", \"Billing and payments\", \"My card expired. How do I update the card on my account before my next order?\", \"Go to Account settings, open Payment methods, and select Add card. After the new card is saved, remove the expired card so it is not selected at checkout. Any active Larkfield Plus subscription switches to the new card automatically.\", \"Thanks for reaching out. Go to Account settings, open Payment methods, and select Add card. After the new card is saved, remove the expired card so it is not selected at checkout. Any active Larkfield Plus subscription switches to the new card automatically.\", \"Happy to help with that. Go to Account settings, open Payment methods, and select Add card. After the new card is saved, remove the expired card so it is not selected at checkout. Any active Larkfield Plus subscription switches to the new card automatically.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S032\", \"Billing and payments\", \"Why was I charged sales tax? I live in a state with no sales tax.\", \"Sales tax is calculated from the shipping address, not the billing address or account state. Your order shipped to an address in a state that charges tax, which is why tax appears on the invoice. If the shipping address is wrong, reply with the correct one and we will review the tax charge.\", \"Thanks for reaching out. Sales tax is based on your billing address. Your order shipped to an address in a state that charges tax, which is why tax appears on the invoice. If the shipping address is wrong, reply with the correct one and we will review the tax charge.\", \"Happy to help with that. Sales tax is calculated from the shipping address, not the billing address or account state. Your order shipped to an address in a state that charges tax, which is why tax appears on the invoice. If the shipping address is wrong, reply with the correct one and we will review the tax charge.\", \"Fail\", \"Pass\", \"Wrong policy fact\", \"\", \"Contains prohibited claim: \"\"based on your billing address\"\".\", \"\", \"Improved\"},",
                "    {\"S033\", \"Account access\", \"I requested a password reset 45 minutes ago and the link says it's invalid. What's wrong?\", \"Reset links expire 30 minutes after they are sent, so that link has timed out. Request a new link from the sign-in page and open it within 30 minutes. If no email arrives within a few minutes, check your spam folder and confirm the address on the account.\", \"Thanks for reaching out. Reset links expire 30 minutes after they are sent, so that link has timed out. Request a new link from the sign-in page and open it within 30 minutes. If no email arrives within a few minutes, check your spam folder and confirm the address on the account.\", \"Happy to help with that. Reset links expire 30 minutes after they are sent, so that link has timed out. If no email arrives within a few minutes, check your spam folder and confirm the address on the account.\", \"Pass\", \"Fail\", \"\", \"Incomplete answer\", \"\", \"Missing required element: \"\"Request a new link\"\".\", \"Regressed\"},",
                "    {\"S034\", \"Account access\", \"I requested a password reset 90 minutes ago and the link says it's invalid. What's wrong?\", \"Reset links expire 30 minutes after they are sent, so that link has timed out. Request a new link from the sign-in page and open it within 30 minutes. If no email arrives within a few minutes, check your spam folder and confirm the address on the account.\", \"Thanks for reaching out. Reset links are valid for 24 hours, so something else is wrong; try a different browser. Request a new link from the sign-in page and open it within 30 minutes. If no email arrives within a few minutes, check your spam folder and confirm the address on the account.\", \"Happy to help with that. Reset links expire 30 minutes after they are sent, so that link has timed out. Request a new link from the sign-in page and open it within 30 minutes. If no email arrives within a few minutes, check your spam folder and confirm the address on the account.\", \"Fail\", \"Pass\", \"Wrong policy fact\", \"\", \"Contains prohibited claim: \"\"24 hours\"\".\", \"\", \"Improved\"},",
                "    {\"S035\", \"Account access\", \"I typed my password wrong 5 times and now I'm locked out. How long does this last?\", \"Accounts lock for 15 minutes after 5 failed sign-in attempts. Wait 15 minutes, then sign in or use Forgot password to set a new one. We never ask for your password by email or chat.\", \"Thanks for reaching out. Accounts lock for 15 minutes after 5 failed sign-in attempts. Wait 15 minutes, then sign in or use Forgot password to set a new one. We never ask for your password by email or chat.\", \"Happy to help with that. Accounts lock for 15 minutes after 5 failed sign-in attempts. Wait 15 minutes, then sign in or use Forgot password to set a new one. We never ask for your password by email or chat.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S036\", \"Account access\", \"I typed my password wrong 7 times and now I'm locked out. How long does this last?\", \"Accounts lock for 15 minutes after 5 failed sign-in attempts. Wait 15 minutes, then sign in or use Forgot password to set a new one. We never ask for your password by email or chat.\", \"Thanks for reaching out. Accounts lock for 15 minutes after 5 failed sign-in attempts. Wait 15 minutes, then sign in or use Forgot password to set a new one. We never ask for your password by email or chat.\", \"Happy to help with that. Accounts lock for 15 minutes after 5 failed sign-in attempts. Wait 15 minutes, then sign in or use Forgot password to set a new one. We never ask for your password by email or chat.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S037\", \"Account access\", \"I want to change the email on my account to my work email. Can you do that for me?\", \"Before we change the sign-in email we verify your identity: please confirm the current email on the account and the number of a recent order. After that, I will send a confirmation link to the new address; the change takes effect when you click it. Until then, keep using the current email to sign in.\", \"Thanks for reaching out. Before we change the sign-in email we verify your identity: please confirm the current email on the account and the number of a recent order. After that, I will send a confirmation link to the new address; the change takes effect when you click it. Until then, keep using the current email to sign in.\", \"Happy to help with that. Done, I've changed the email on your account to the new address. After that, I will send a confirmation link to the new address; the change takes effect when you click it. Until then, keep using the current email to sign in.\", \"Pass\", \"Fail\", \"\", \"Missing required step\", \"\", \"Contains prohibited claim: \"\"I've changed the email\"\".\", \"Regressed\"},",
                "    {\"S038\", \"Account access\", \"I want to change the email on my account to a new Gmail address. Can you do that for me?\", \"Before we change the sign-in email we verify your identity: please confirm the current email on the account and the number of a recent order. After that, I will send a confirmation link to the new address; the change takes effect when you click it. Until then, keep using the current email to sign in.\", \"Thanks for reaching out. Before we change the sign-in email we verify your identity: please confirm the current email on the account and the number of a recent order. Until then, keep using the current email to sign in.\", \"Happy to help with that. Before we change the sign-in email we verify your identity: please confirm the current email on the account and the number of a recent order. After that, I will send a confirmation link to the new address; the change takes effect when you click it. Until then, keep using the current email to sign in.\", \"Fail\", \"Pass\", \"Incomplete answer\", \"\", \"Missing required element: \"\"confirmation link\"\".\", \"\", \"Improved\"},",
                "    {\"S039\", \"Account access\", \"I lost my phone and can't get my two-factor codes. How do I sign in?\", \"Use one of the backup codes you saved when two-factor authentication was set up; each code works once. If you have no backup codes, submit the account recovery form; recovery takes up to 2 business days while we verify your identity. Once you are back in, add the authenticator on your new phone under Security settings.\", \"Thanks for reaching out. Use one of the backup codes you saved when two-factor authentication was set up; each code works once. I've turned off two-factor authentication on your account so you can sign in with just your password. Once you are back in, add the authenticator on your new phone under Security settings.\", \"Happy to help with that. Use one of the backup codes you saved when two-factor authentication was set up; each code works once. If you have no backup codes, submit the account recovery form; recovery takes up to 2 business days while we verify your identity. Once you are back in, add the authenticator on your new phone under Security settings.\", \"Fail\", \"Pass\", \"Unsupported promise\", \"\", \"Contains prohibited claim: \"\"I've turned off two-factor\"\".\", \"\", \"Improved\"},",
                "    {\"S040\", \"Account access\", \"Please delete my account and all my data.\", \"You can request deletion under Account settings, Privacy, Delete account. The account is deactivated immediately and permanently deleted after a 30-day grace period, during which you can sign in to cancel the request. Order records required for tax and warranty purposes are retained as the law requires.\", \"Thanks for reaching out. You can request deletion under Account settings, Privacy, Delete account. The account is deactivated immediately and permanently deleted after a 30-day grace period, during which you can sign in to cancel the request. Order records required for tax and warranty purposes are retained as the law requires.\", \"Happy to help with that. You can request deletion under Account settings, Privacy, Delete account. The account is deactivated immediately and permanently deleted after a 30-day grace period, during which you can sign in to cancel the request. Order records required for tax and warranty purposes are retained as the law requires.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S041\", \"Account access\", \"I'm not getting the sign-in verification email. I've checked spam.\", \"First confirm the email on your account is spelled correctly under Account settings. Add noreply@larkfield.example to your safe-sender list and request the code again. If it still does not arrive within 10 minutes, reply here and we can switch verification to SMS after confirming your identity.\", \"Thanks for reaching out. First confirm the email on your account is spelled correctly under Account settings. Add noreply@larkfield.example to your safe-sender list and request the code again. If it still does not arrive within 10 minutes, reply here and we can switch verification to SMS after confirming your identity.\", \"Happy to help with that. First confirm the email on your account is spelled correctly under Account settings. Add noreply@larkfield.example to your safe-sender list and request the code again. If it still does not arrive within 10 minutes, reply here and we can switch verification to SMS after confirming your identity.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S042\", \"Device troubleshooting\", \"My Larkfield smart plug in the kitchen shows offline since yesterday. The Wi-Fi is working for everything else.\", \"Let's get it back online. First, confirm your phone is connected to the 2.4 GHz band of your Wi-Fi; the plug cannot join 5 GHz networks. Second, unplug the smart plug for 30 seconds and plug it back in. Third, if it is still offline, hold the button for 10 seconds until the light blinks blue, then re-add it in the Larkfield app. Finally, after it reconnects, check Settings in the app for a firmware update.\", \"Thanks for reaching out. Let's get it back online. First, confirm your phone is connected to the 2.4 GHz band of your Wi-Fi; the plug cannot join 5 GHz networks. Second, unplug the smart plug for 30 seconds and plug it back in. Third, if it is still offline, hold the button for 10 seconds until the light blinks blue, then re-add it in the Larkfield app.\", \"Happy to help with that. Let's get it back online. First, confirm your phone is connected to the 2.4 GHz band of your Wi-Fi; the plug cannot join 5 GHz networks. Second, unplug the smart plug for 30 seconds and plug it back in. Third, if it is still offline, hold the button for 10 seconds until the light blinks blue, then re-add it in the Larkfield app. Finally, after it reconnects, check Settings in the app for a firmware update.\", \"Fail\", \"Pass\", \"Missing required step\", \"\", \"Missing required element: \"\"firmware update\"\".\", \"\", \"Improved\"},",
                "    {\"S043\", \"Device troubleshooting\", \"My Larkfield smart plug in the bedroom shows offline since yesterday. The Wi-Fi is working for everything else.\", \"Let's get it back online. First, confirm your phone is connected to the 2.4 GHz band of your Wi-Fi; the plug cannot join 5 GHz networks. Second, unplug the smart plug for 30 seconds and plug it back in. Third, if it is still offline, hold the button for 10 seconds until the light blinks blue, then re-add it in the Larkfield app. Finally, after it reconnects, check Settings in the app for a firmware update.\", \"Thanks for reaching out. Let's get it back online. First, confirm your phone is connected to the 2.4 GHz band of your Wi-Fi; the plug cannot join 5 GHz networks. Second, unplug the smart plug for 30 seconds and plug it back in. Third, if it is still offline, hold the button for 10 seconds until the light blinks blue, then re-add it in the Larkfield app. Finally, after it reconnects, check Settings in the app for a firmware update.\", \"Happy to help with that. Let's get it back online. First, confirm your phone is connected to the 2.4 GHz band of your Wi-Fi; the plug cannot join 5 GHz networks. Second, unplug the smart plug for 30 seconds and plug it back in. Third, if it is still offline, hold the button for 10 seconds until the light blinks blue, then re-add it in the Larkfield app. Finally, after it reconnects, check Settings in the app for a firmware update.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S044\", \"Device troubleshooting\", \"My Larkfield smart plug in the garage shows not responding in the app since yesterday. The Wi-Fi is working for everything else.\", \"Let's get it back online. First, confirm your phone is connected to the 2.4 GHz band of your Wi-Fi; the plug cannot join 5 GHz networks. Second, unplug the smart plug for 30 seconds and plug it back in. Third, if it is still offline, hold the button for 10 seconds until the light blinks blue, then re-add it in the Larkfield app. Finally, after it reconnects, check Settings in the app for a firmware update.\", \"Thanks for reaching out. Let's get it back online. First, confirm your phone is connected to the 2.4 GHz band of your Wi-Fi; the plug cannot join 5 GHz networks. Third, if it is still offline, hold the button for 10 seconds until the light blinks blue, then re-add it in the Larkfield app. Finally, after it reconnects, check Settings in the app for a firmware update.\", \"Happy to help with that. Let's get it back online. First, confirm your phone is connected to the 2.4 GHz band of your Wi-Fi; the plug cannot join 5 GHz networks. Second, unplug the smart plug for 30 seconds and plug it back in. Third, if it is still offline, hold the button for 10 seconds until the light blinks blue, then re-add it in the Larkfield app. Finally, after it reconnects, check Settings in the app for a firmware update.\", \"Fail\", \"Pass\", \"Missing required step\", \"\", \"Missing required element: \"\"30 seconds\"\".\", \"\", \"Improved\"},",
                "    {\"S045\", \"Device troubleshooting\", \"My Larkfield Wi-Fi speaker in the living room keeps dropping the connection. I've already restarted my phone.\", \"First, move the speaker within 15 feet of the router or remove anything between them, then test again. Second, power the speaker off, wait 30 seconds, and power it on. Third, in the Larkfield app open the speaker, choose Forget device, then run Add device again while on the 2.4 GHz network. Finally, check Settings for a firmware update; connection fixes shipped in version 2.8.\", \"Thanks for reaching out. First, move the speaker within 15 feet of the router or remove anything between them, then test again. Second, power the speaker off, wait 30 seconds, and power it on. Third, in the Larkfield app open the speaker, choose Forget device, then run Add device again while on the 2.4 GHz network. Finally, check Settings for a firmware update; connection fixes shipped in version 2.8.\", \"Happy to help with that. First, move the speaker within 15 feet of the router or remove anything between them, then test again. Second, power the speaker off, wait 30 seconds, and power it on. Third, in the Larkfield app open the speaker, choose Forget device, then run Add device again while on the 2.4 GHz network. Finally, check Settings for a firmware update; connection fixes shipped in version 2.8.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S046\", \"Device troubleshooting\", \"My Larkfield Wi-Fi speaker in the office won't pair at all. I've already restarted my phone.\", \"First, move the speaker within 15 feet of the router or remove anything between them, then test again. Second, power the speaker off, wait 30 seconds, and power it on. Third, in the Larkfield app open the speaker, choose Forget device, then run Add device again while on the 2.4 GHz network. Finally, check Settings for a firmware update; connection fixes shipped in version 2.8.\", \"Thanks for reaching out. First, move the speaker within 15 feet of the router or remove anything between them, then test again. Third, in the Larkfield app open the speaker, choose Forget device, then run Add device again while on the 2.4 GHz network. Finally, check Settings for a firmware update; connection fixes shipped in version 2.8.\", \"Happy to help with that. First, move the speaker within 15 feet of the router or remove anything between them, then test again. Second, power the speaker off, wait 30 seconds, and power it on. Finally, check Settings for a firmware update; connection fixes shipped in version 2.8.\", \"Fail\", \"Fail\", \"Missing required step\", \"Missing required step\", \"Missing required element: \"\"30 seconds\"\".\", \"Missing required element: \"\"Forget device\"\".\", \"Both fail\"},",
                "    {\"S047\", \"Device troubleshooting\", \"My Larkfield Wi-Fi speaker in the kitchen plays for a minute then cuts out. I've already restarted my phone.\", \"First, move the speaker within 15 feet of the router or remove anything between them, then test again. Second, power the speaker off, wait 30 seconds, and power it on. Third, in the Larkfield app open the speaker, choose Forget device, then run Add device again while on the 2.4 GHz network. Finally, check Settings for a firmware update; connection fixes shipped in version 2.8.\", \"Thanks for reaching out. First, move the speaker within 15 feet of the router or remove anything between them, then test again. Second, power the speaker off, wait 30 seconds, and power it on. Third, in the Larkfield app open the speaker, choose Forget device, then run Add device again while on the 2.4 GHz network. Finally, check Settings for a firmware update; connection fixes shipped in version 2.8.\", \"Happy to help with that. First, move the speaker within 15 feet of the router or remove anything between them, then test again. Second, power the speaker off, wait 30 seconds, and power it on. Third, in the Larkfield app open the speaker, choose Forget device, then run Add device again while on the 2.4 GHz network. Finally, check Settings for a firmware update; connection fixes shipped in version 2.8.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S048\", \"Device troubleshooting\", \"The Larkfield video doorbell at my front door doesn't send motion alerts. It worked fine last month.\", \"First, check the doorbell's battery level in the app; below 20 percent, motion detection and video are turned off until it is charged. Second, confirm notifications for the Larkfield app are allowed in your phone's settings. Third, in the app open the doorbell, choose Restart device, and wait two minutes. Finally, check Settings for a firmware update and install it if one is listed.\", \"Thanks for reaching out. Second, confirm notifications for the Larkfield app are allowed in your phone's settings. Third, in the app open the doorbell, choose Restart device, and wait two minutes. Finally, check Settings for a firmware update and install it if one is listed.\", \"Happy to help with that. First, check the doorbell's battery level in the app; below 20 percent, motion detection and video are turned off until it is charged. Second, confirm notifications for the Larkfield app are allowed in your phone's settings. Third, in the app open the doorbell, choose Restart device, and wait two minutes. Finally, check Settings for a firmware update and install it if one is listed.\", \"Fail\", \"Pass\", \"Missing required step\", \"\", \"Missing required element: \"\"battery level\"\".\", \"\", \"Improved\"},",
                "    {\"S049\", \"Device troubleshooting\", \"The Larkfield video doorbell at my side door shows a black video feed. It worked fine last month.\", \"First, check the doorbell's battery level in the app; below 20 percent, motion detection and video are turned off until it is charged. Second, confirm notifications for the Larkfield app are allowed in your phone's settings. Third, in the app open the doorbell, choose Restart device, and wait two minutes. Finally, check Settings for a firmware update and install it if one is listed.\", \"Thanks for reaching out. First, check the doorbell's battery level in the app; below 20 percent, motion detection and video are turned off until it is charged. Second, confirm notifications for the Larkfield app are allowed in your phone's settings. Third, in the app open the doorbell, choose Restart device, and wait two minutes.\", \"Happy to help with that. First, check the doorbell's battery level in the app; below 20 percent, motion detection and video are turned off until it is charged. Third, in the app open the doorbell, choose Restart device, and wait two minutes. Finally, check Settings for a firmware update and install it if one is listed.\", \"Fail\", \"Fail\", \"Missing required step\", \"Missing required step\", \"Missing required element: \"\"firmware update\"\".\", \"Missing required element: \"\"notifications\"\".\", \"Both fail\"},",
                "    {\"S050\", \"Device troubleshooting\", \"The Larkfield video doorbell at my back door rings but the app never opens. It worked fine last month.\", \"First, check the doorbell's battery level in the app; below 20 percent, motion detection and video are turned off until it is charged. Second, confirm notifications for the Larkfield app are allowed in your phone's settings. Third, in the app open the doorbell, choose Restart device, and wait two minutes. Finally, check Settings for a firmware update and install it if one is listed.\", \"Thanks for reaching out. Second, confirm notifications for the Larkfield app are allowed in your phone's settings. Third, in the app open the doorbell, choose Restart device, and wait two minutes. Finally, check Settings for a firmware update and install it if one is listed.\", \"Happy to help with that. First, check the doorbell's battery level in the app; below 20 percent, motion detection and video are turned off until it is charged. Second, confirm notifications for the Larkfield app are allowed in your phone's settings. Third, in the app open the doorbell, choose Restart device, and wait two minutes. Finally, check Settings for a firmware update and install it if one is listed.\", \"Fail\", \"Pass\", \"Missing required step\", \"\", \"Missing required element: \"\"battery level\"\".\", \"\", \"Improved\"},",
                "    {\"S051\", \"Device troubleshooting\", \"My Larkfield thermostat screen is blank. Is it broken?\", \"A blank screen usually means no power. First, check that the circuit breaker for your HVAC system is on. Second, remove the thermostat from its base and confirm the C wire is connected to the C terminal; without it the unit cannot charge. Third, reattach the thermostat and wait 10 minutes for the internal battery to charge. If the screen stays blank after that, reply with a photo of the wiring and we will arrange a warranty replacement.\", \"Thanks for reaching out. A blank screen usually means no power. First, check that the circuit breaker for your HVAC system is on. Second, remove the thermostat from its base and confirm the C wire is connected to the C terminal; without it the unit cannot charge. Third, reattach the thermostat and wait 10 minutes for the internal battery to charge. If the screen stays blank after that, reply with a photo of the wiring and we will arrange a warranty replacement.\", \"Happy to help with that. A blank screen usually means no power. First, check that the circuit breaker for your HVAC system is on. Second, remove the thermostat from its base and confirm the C wire is connected to the C terminal; without it the unit cannot charge. Third, reattach the thermostat and wait 10 minutes for the internal battery to charge. If the screen stays blank after that, reply with a photo of the wiring and we will arrange a warranty replacement.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S052\", \"Device troubleshooting\", \"The Larkfield app says my hub firmware update failed and now none of my devices respond.\", \"First, leave the hub powered on and connected for 15 minutes; it retries the update automatically. Second, if the light is still red, unplug the hub for 30 seconds and plug it back in to retry. Third, in the app open the hub, choose Check for updates, and install any pending version. Do not factory reset the hub, because that removes every paired device and they would all need re-pairing.\", \"Thanks for reaching out. Second, if the light is still red, unplug the hub for 30 seconds and plug it back in to retry. Third, in the app open the hub, choose Check for updates, and install any pending version. Do not factory reset the hub, because that removes every paired device and they would all need re-pairing.\", \"Happy to help with that. First, leave the hub powered on and connected for 15 minutes; it retries the update automatically. Second, if the light is still red, unplug the hub for 30 seconds and plug it back in to retry. Third, in the app open the hub, choose Check for updates, and install any pending version. Do not factory reset the hub, because that removes every paired device and they would all need re-pairing.\", \"Fail\", \"Pass\", \"Missing required step\", \"\", \"Missing required element: \"\"15 minutes\"\".\", \"\", \"Improved\"},",
                "    {\"S053\", \"Subscriptions\", \"I want to cancel Larkfield Plus. My billing date is the 3rd. Will I get money back for the rest of the month?\", \"You can cancel any time under Account settings, Subscriptions, Cancel plan. The cancellation takes effect at the end of the current billing period, so you keep Plus benefits until your next billing date. We do not prorate or refund the unused part of a monthly period.\", \"Thanks for reaching out. You can cancel any time under Account settings, Subscriptions, Cancel plan. The cancellation takes effect at the end of the current billing period, so you keep Plus benefits until your next billing date. We do not prorate or refund the unused part of a monthly period.\", \"Happy to help with that. You can cancel any time under Account settings, Subscriptions, Cancel plan. The cancellation takes effect at the end of the current billing period, so you keep Plus benefits until your next billing date.\", \"Pass\", \"Fail\", \"\", \"Incomplete answer\", \"\", \"Missing required element: \"\"not prorate\"\".\", \"Regressed\"},",
                "    {\"S054\", \"Subscriptions\", \"I want to cancel Larkfield Plus. My billing date is the 18th. Will I get money back for the rest of the month?\", \"You can cancel any time under Account settings, Subscriptions, Cancel plan. The cancellation takes effect at the end of the current billing period, so you keep Plus benefits until your next billing date. We do not prorate or refund the unused part of a monthly period.\", \"Thanks for reaching out. You can cancel any time under Account settings, Subscriptions, Cancel plan. The cancellation takes effect at the end of the current billing period, so you keep Plus benefits until your next billing date. We do not prorate or refund the unused part of a monthly period.\", \"Happy to help with that. You can cancel any time under Account settings, Subscriptions, Cancel plan. The cancellation takes effect at the end of the current billing period, so you keep Plus benefits until your next billing date. We do not prorate or refund the unused part of a monthly period.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S055\", \"Subscriptions\", \"I want to cancel Larkfield Plus. My billing date is the 25th. Will I get money back for the rest of the month?\", \"You can cancel any time under Account settings, Subscriptions, Cancel plan. The cancellation takes effect at the end of the current billing period, so you keep Plus benefits until your next billing date. We do not prorate or refund the unused part of a monthly period.\", \"Thanks for reaching out. You can cancel any time under Account settings, Subscriptions, Cancel plan. The cancellation takes effect at the end of the current billing period, so you keep Plus benefits until your next billing date. We do not prorate or refund the unused part of a monthly period.\", \"Happy to help with that. You can cancel any time under Account settings, Subscriptions, Cancel plan. The cancellation takes effect at the end of the current billing period, so you keep Plus benefits until your next billing date. We do not prorate or refund the unused part of a monthly period.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S056\", \"Subscriptions\", \"Can I pause my Plus subscription for 2 months while I'm traveling?\", \"Plus can be paused for up to 3 months at a time from Account settings, Subscriptions, Pause plan. A 2-month pause is within that limit. Billing stops during the pause and resumes automatically on the restart date you choose.\", \"Thanks for reaching out. Plus can be paused for up to 3 months at a time from Account settings, Subscriptions, Pause plan. A 2-month pause is within that limit. Billing stops during the pause and resumes automatically on the restart date you choose.\", \"Happy to help with that. Plus can be paused for up to 6 months at a time from Account settings, Subscriptions, Pause plan. A 2-month pause is within that limit. Billing stops during the pause and resumes automatically on the restart date you choose.\", \"Pass\", \"Fail\", \"\", \"Wrong policy fact\", \"\", \"Contains prohibited claim: \"\"up to 6 months\"\".\", \"Regressed\"},",
                "    {\"S057\", \"Subscriptions\", \"Can I pause my Plus subscription for 4 months while I'm traveling?\", \"Plus can be paused for up to 3 months at a time from Account settings, Subscriptions, Pause plan. A 4-month pause is longer than the limit, so you would need to cancel and rejoin, or pause for 3 months and extend. Billing stops during the pause and resumes automatically on the restart date you choose.\", \"Thanks for reaching out. Plus can be paused for up to 3 months at a time from Account settings, Subscriptions, Pause plan. A 4-month pause is longer than the limit, so you would need to cancel and rejoin, or pause for 3 months and extend. Billing stops during the pause and resumes automatically on the restart date you choose.\", \"Happy to help with that. Plus can be paused for up to 3 months at a time from Account settings, Subscriptions, Pause plan. A 4-month pause is longer than the limit, so you would need to cancel and rejoin, or pause for 3 months and extend. Billing stops during the pause and resumes automatically on the restart date you choose.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S058\", \"Subscriptions\", \"I'm on the monthly Plus plan. If I switch to annual today, when does it start?\", \"Plan changes take effect at your next renewal date, not immediately. You keep the monthly plan until then, and the annual charge of $89 is billed on that date. You can undo the switch any time before the renewal date.\", \"Thanks for reaching out. Plan changes take effect at your next renewal date, not immediately. You can undo the switch any time before the renewal date.\", \"Happy to help with that. Plan changes take effect at your next renewal date, not immediately. You keep the monthly plan until then, and the annual charge of $89 is billed on that date. You can undo the switch any time before the renewal date.\", \"Fail\", \"Pass\", \"Incomplete answer\", \"\", \"Missing required element: \"\"$89\"\".\", \"\", \"Improved\"},",
                "    {\"S059\", \"Subscriptions\", \"My annual Plus renewed yesterday and I didn't want it. Can I get a refund?\", \"We send a renewal reminder 7 days before an annual plan renews. Annual renewals can be refunded in full within 14 days of the renewal charge if no Plus benefits have been used in that period. Your renewal was yesterday, so you qualify; I have cancelled the plan and the refund will post in 5 to 7 business days.\", \"Thanks for reaching out. We send a renewal reminder 7 days before an annual plan renews. Annual renewals can be refunded in full within 14 days of the renewal charge if no Plus benefits have been used in that period. Your renewal was yesterday, so you qualify; I have cancelled the plan and the refund will post in 5 to 7 business days.\", \"Happy to help with that. We send a renewal reminder 7 days before an annual plan renews. Annual renewals can be refunded in full within 14 days of the renewal charge if no Plus benefits have been used in that period. Your renewal was yesterday, so you qualify; I have cancelled the plan and the refund will post in 5 to 7 business days.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"},",
                "    {\"S060\", \"Subscriptions\", \"I started a free trial of Plus. When do I have to cancel to avoid being charged?\", \"The free trial lasts 14 days; cancel before the trial end date shown under Subscriptions to avoid the first charge. If you do nothing, the monthly plan starts at $8.99 on day 15. We email a reminder 3 days before the trial ends.\", \"Thanks for reaching out. The free trial lasts 14 days; cancel before the trial end date shown under Subscriptions to avoid the first charge. We email a reminder 3 days before the trial ends.\", \"Happy to help with that. The free trial lasts 14 days; cancel before the trial end date shown under Subscriptions to avoid the first charge. If you do nothing, the monthly plan starts at $8.99 on day 15. We email a reminder 3 days before the trial ends.\", \"Fail\", \"Pass\", \"Incomplete answer\", \"\", \"Missing required element: \"\"$8.99\"\".\", \"\", \"Improved\"},",
                "    {\"S061\", \"Subscriptions\", \"Does Plus include free expedited shipping on every order?\", \"Plus includes free standard shipping on every order with no minimum. Expedited delivery is discounted to $7.99 for Plus members rather than free. Plus also includes early access to sales and an extended 60-day return window on standard items.\", \"Thanks for reaching out. Yes, Plus includes free expedited shipping on every order. Expedited delivery is discounted to $7.99 for Plus members rather than free. Plus also includes early access to sales and an extended 60-day return window on standard items.\", \"Happy to help with that. Plus includes free standard shipping on every order with no minimum. Expedited delivery is discounted to $7.99 for Plus members rather than free. Plus also includes early access to sales and an extended 60-day return window on standard items.\", \"Fail\", \"Pass\", \"Wrong policy fact\", \"\", \"Contains prohibited claim: \"\"free expedited shipping\"\".\", \"\", \"Improved\"},",
                "    {\"S062\", \"Subscriptions\", \"I was charged for Plus but I cancelled last month. Why?\", \"Cancellations take effect at the end of the billing period in which they are made, so a cancellation made after your billing date leaves one more charge. I can see the cancellation request on file; if the charge posted after the period ended, reply with the charge date and we will refund it. You will receive a confirmation email when the plan is fully closed.\", \"Thanks for reaching out. Cancellations take effect at the end of the billing period in which they are made, so a cancellation made after your billing date leaves one more charge. I can see the cancellation request on file; if the charge posted after the period ended, reply with the charge date and we will refund it. You will receive a confirmation email when the plan is fully closed.\", \"Happy to help with that. Cancellations take effect at the end of the billing period in which they are made, so a cancellation made after your billing date leaves one more charge. I can see the cancellation request on file; if the charge posted after the period ended, reply with the charge date and we will refund it. You will receive a confirmation email when the plan is fully closed.\", \"Pass\", \"Pass\", \"\", \"\", \"\", \"\", \"Both pass\"}",
                "})"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Scenario count",
            "expression": "COALESCE(COUNTROWS(Scenarios), 0)",
            "formatString": "#,0"
          },
          {
            "name": "A passes",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Scenarios), KEEPFILTERS(Scenarios[a_result] = \"Pass\")), 0)",
            "formatString": "#,0"
          },
          {
            "name": "B passes",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Scenarios), KEEPFILTERS(Scenarios[b_result] = \"Pass\")), 0)",
            "formatString": "#,0"
          },
          {
            "name": "A failures",
            "expression": "[Scenario count] - [A passes]",
            "formatString": "#,0"
          },
          {
            "name": "B failures",
            "expression": "[Scenario count] - [B passes]",
            "formatString": "#,0"
          },
          {
            "name": "A pass rate",
            "expression": "DIVIDE([A passes], [Scenario count])",
            "formatString": "0.0%"
          },
          {
            "name": "B pass rate",
            "expression": "DIVIDE([B passes], [Scenario count])",
            "formatString": "0.0%"
          },
          {
            "name": "Pass rate change",
            "expression": "[B pass rate] - [A pass rate]",
            "formatString": "+0.0%;-0.0%;0.0%"
          },
          {
            "name": "Improved",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Scenarios), KEEPFILTERS(Scenarios[change] = \"Improved\")), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Regressed",
            "expression": "COALESCE(CALCULATE(COUNTROWS(Scenarios), KEEPFILTERS(Scenarios[change] = \"Regressed\")), 0)",
            "formatString": "#,0"
          },
          {
            "name": "Net change",
            "expression": "[B passes] - [A passes]",
            "formatString": "+#,0;-#,0;0"
          }
        ]
      }
    ]
  }
}
